---
import '../styles/global.css';
import '../styles/experience.css';
import '../styles/page-flip.css';
import { ClientRouter } from 'astro:transitions';
import Ambience from '../components/Ambience.astro';
import site from '../content/site.json';
interface Props { title?: string; wide?: boolean; quiet?: boolean }
const { title = 'Uma biblioteca de muitas vozes', wide = false, quiet = false } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter fallback="swap" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Uma experiência independente de leitura e estudo. Biblioteca experimental com amostra fornecida de Gênesis e textos fictícios de teste." />
    <meta name="theme-color" content="#171b17" />
    <title>{title} · {site.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={{ 'quiet-layout': quiet }}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="demo-banner">Protótipo independente · <a href="https://nossabiblialivre.com/">Projeto oficial ↗</a></div>
    {!quiet && <header class="site-header">
      <a class="brand" href="/"><img class="brand-logo" src="/img/logo.png" alt="" width="90" height="60" /><span>Nossa Bíblia Livre</span></a>
      <nav aria-label="Principal">
        <a aria-current={path === '/' ? 'page' : undefined} href="/">Início</a>
        <a aria-current={path.startsWith('/projeto') ? 'page' : undefined} href="/projeto/">Projeto</a>
        <a aria-current={path.startsWith('/tradutor') ? 'page' : undefined} href="/tradutor/">Tradutor</a>
        <a aria-current={path.startsWith('/biblioteca') ? 'page' : undefined} href="/biblioteca/">Biblioteca</a>
        <a class="nav-workshop" aria-current={path.startsWith('/experimentar') ? 'page' : undefined} href="/experimentar/genesis/">Oficina de edição</a>
      </nav>
    </header>}
    <Ambience />
    <main id="conteudo" class:list={['container', { wide }]}><slot /></main>
    <footer class="site-footer">
      <span class="footer-brand">{site.title}</span>
      <p>Uma interface experimental, independente e não oficial.<br />Gênesis: amostra fornecida da tradução de Osvaldo Luiz Ribeiro.</p>
      <a href="/experimentar/genesis/">Oficina de edição</a><a href="/admin/" data-astro-reload>Sveltia CMS</a><a href="https://nossabiblialivre.com/">Visitar Nossa Bíblia Livre ↗</a>
    </footer>
  </body>
</html>
