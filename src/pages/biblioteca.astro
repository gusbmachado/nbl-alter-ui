---
import Layout from '../layouts/Layout.astro';
import Continue from '../components/Continue';
import BookCover from '../components/BookCover';
import { compile } from '../lib/content';
import { progress, stateLabel } from '../lib/catalog';
const { catalog } = compile();
---
<Layout title="Biblioteca">
  <section class="page-intro"><p class="eyebrow">O ACERVO</p><h1>Biblioteca</h1><p>Muitas vozes, reunidas sem perder suas diferenças.<br />Os tomos com brilho dourado podem ser abertos. Os demais aguardam publicação.</p><Continue books={catalog.books} client:load /></section>
  <nav class="collection-jumps" aria-label="Coleções">{catalog.collections.map(c => <a href={`#${c.id}`}>{c.title}</a>)}</nav>
  <div class="library-toolbar">
    <label class="search-label"><span>Buscar livro</span><input id="book-search" type="search" placeholder="Título do livro…" /></label>
    <label class="available-filter"><input id="only-available" type="checkbox" /> Disponíveis para leitura</label>
    <div class="view-options" aria-label="Visualização"><button id="shelf-view" aria-pressed="true">▥ Estante</button><button id="catalog-view" aria-pressed="false">☷ Catálogo</button></div>
  </div>
  <p id="search-result" class="caption" aria-live="polite">{catalog.books.length} livros no catálogo · disponibilidade exclusiva deste protótipo</p>
  <div id="library" class="library">
    {catalog.collections.map((collection, i) => {
      const books = catalog.books.filter(b => b.collectionId === collection.id);
      const stats = progress(books);
      return <section id={collection.id} class={`shelf-section ${collection.coverVariant}`}>
        <div class="section-heading"><div class="collection-heading"><div class="collection-cover-preview"><BookCover title={collection.title} variant={collection.coverVariant} kind="institutional" subtitle="COLEÇÃO" /></div><div><p class="eyebrow">COLEÇÃO {String(i + 1).padStart(2, '0')}</p><h2>{collection.title}</h2></div></div><p class="caption">{stats.published} / {stats.total ?? 'a definir'} capítulos disponíveis</p></div>
        <>{Array.from({ length: Math.ceil(books.length / 14) }, (_, row) => <ul class="bookshelf">{books.slice(row * 14, row * 14 + 14).map(book => <li class:list={['book-item', { available: book.chapters.length > 0 }]} data-title={book.title} data-available={book.chapters.length > 0}>
          <a class="spine" href={book.chapters.length ? `/ler/${book.slug}/` : `/livros/${book.slug}/`} aria-label={`${book.chapters.length ? "Abrir " : "Sobre "}${book.title} — ${stateLabel(book)}`}><span class="spine-ornament" aria-hidden="true">❧</span><span class="spine-title">{book.title}</span><span class="spine-state" aria-hidden="true">{book.chapters.length ? '●' : '○'}</span></a>
          <div class="catalog-detail"><h3><a href={`/livros/${book.slug}/`}>{book.title}</a></h3><span class:list={['badge', { ready: book.chapters.length > 0 }]}>{stateLabel(book)}</span><p>{book.chapters.length} / {book.totalChapters ?? 'a definir'} capítulos</p>{book.chapters.length > 0 ? <a class="text-link" href={`/ler/${book.slug}/`}>Abrir tomo →</a> : <span class="caption">Aguardando publicação</span>}</div>
        </li>)}</ul>)}</>
      </section>;
    })}
  </div>
  <p class="notice">Os títulos fazem parte do catálogo planejado. Gênesis 1–3 contém a amostra real fornecida pelo responsável. Salmos contém somente um texto fictício para testes. Os números não representam o andamento do projeto oficial.</p>
</Layout>
<script>
  document.addEventListener('astro:page-load', () => {
  const library = document.querySelector<HTMLElement>('#library')!;
  if (!library) return;
  const shelf = document.querySelector<HTMLButtonElement>('#shelf-view')!;
  const catalog = document.querySelector<HTMLButtonElement>('#catalog-view')!;
  function mode(value: boolean) {
    library.classList.toggle('catalog-mode', value);
    shelf.setAttribute('aria-pressed', String(!value));
    catalog.setAttribute('aria-pressed', String(value));
  }
  shelf.addEventListener('click', () => mode(false));
  catalog.addEventListener('click', () => mode(true));
  const normalize = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  function filter() {
    const query = normalize(document.querySelector<HTMLInputElement>('#book-search')!.value);
    const onlyAvailable = document.querySelector<HTMLInputElement>('#only-available')!.checked;
    let count = 0;
    library.querySelectorAll<HTMLElement>('.book-item').forEach(item => {
      item.hidden = !normalize(item.dataset.title || '').includes(query) || (onlyAvailable && item.dataset.available !== 'true');
      if (!item.hidden) count++;
    });
    library.querySelectorAll<HTMLElement>('.bookshelf').forEach(shelf => { shelf.hidden = !shelf.querySelector('.book-item:not([hidden])'); });
    library.querySelectorAll<HTMLElement>('.shelf-section').forEach(section => {
      section.hidden = !section.querySelector('.book-item:not([hidden])');
    });
    document.querySelector('#search-result')!.textContent = count ? `${count} livros encontrados` : 'Nenhum livro encontrado. Altere a busca ou desmarque o filtro.';
  }
  document.querySelector('#book-search')!.addEventListener('input', filter);
  document.querySelector('#only-available')!.addEventListener('change', filter);
  });
</script>
