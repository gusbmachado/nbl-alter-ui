{
  "name": "nossa-biblioteca-livre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm content:build && astro dev",
    "build": "pnpm content:build && astro build && tsx scripts/check-export.ts",
    "content:validate": "tsx scripts/content.ts --validate",
    "content:build": "tsx scripts/content.ts",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.0.0",
    "page-flip": "2.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
